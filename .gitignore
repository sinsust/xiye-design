# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.next-tmp/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# xiye 本地 SQLite 数据库（本地存档用，勿入库）
xiye.db
xiye.db-shm
xiye.db-wal

# 用户自建知识库（运行时由 /library 写入，含私有内容，勿入库）
knowledge/user/
.originkit/

# 本地打包产物 / 二进制
xiye-dev.exe
xiye-dev.spec

# Trae IDE 配置（不入库）
.trae/
# 调试用的报错快照 / 日志（含转义类名，会被 Tailwind 内容扫描误当成类源，勿入库）
.trae-err*.html
.trae-build.log
.next-tmp/

# 临时 npm pack 调试产物
*.tgz
postgres-3.4.9.tgz

# 独立模板工程（顶层 /outstand、/genius、/wexo 是独立整站项目，不并入主仓库；
# 其组件库副本 components/originkit/<name> 与资源 public/originkit/<name> 必须入库）
/outstand/
/genius/
/wexo/

# python 缓存
__pycache__/

# 临时 npm 缓存目录
/.npm-tmp
/.tmp-npm-cache

# WorkBuddy 项目私有数据（勿入库）
.workbuddy/

# 临时分析报告产物
section-analysis-report.md

# 调试/临时产物（勿入库）
dev-server.log
diag.mjs
*.bak
*.removed
pnpm-lock.yaml
pnpm-workspace.yaml
