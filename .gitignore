xiye.db
xiye.db-shm
xiye.db-wal

# 用户自建知识库（运行时由 /library 写入，含私有内容，勿入库）
knowledge/user/
.originkit/

# 本地打包产物 / 二进制
xiye-dev.exe
xiye-dev.spec

# Trae IDE 配置（不入库）
.trae/
# 调试用的报错快照 / 日志（含转义类名，会被 Tailwind 内容扫描误当成类源，勿入库）
.trae-err*.html
.trae-build.log
.next-tmp/

# 临时 npm pack 调试产物
*.tgz
postgres-3.4.9.tgz

# 整站模板：必须入库！品牌包下载 packBrand 直接从 process.cwd()/<rootDir> 读取原始目录，
# 线上部署若缺失会抛 "brand dir not found"。仅提交可交付源码，排除依赖与构建产物。
# 其组件库副本 components/originkit/<name> 与资源 public/originkit/<name> 同样入库。
outstand/node_modules/
outstand/.next/
outstand/.git/
genius/node_modules/
genius/.next/
wexo/node_modules/
wexo/.next/

# python 缓存
__pycache__/

# 临时 npm 缓存目录
/.npm-tmp
/.tmp-npm-cache

# WorkBuddy 项目私有数据（勿入库）
.workbuddy/

# 临时分析报告产物
section-analysis-report.md

# 调试/临时产物（勿入库）
dev-server.log
diag.mjs
*.bak
*.removed
pnpm-lock.yaml
pnpm-workspace.yaml

# 本地构建产物 / 一次性脚本 / 测试库（防误提交，2026-08-26）
.next-old/
build.log
build.err.log
scripts/.tmp-*.mjs
scripts/_fix-brain.mjs
scripts/validation-*.mts
xiye-*-test.db
xiye-*-test.db-shm
xiye-*-test.db-wal

# 表格金标样本（T0 支线，2026-08-26）：生成的二进制与报告产物不入库
data/table-fixtures/generated/
artifacts/table-baseline/
# 但下列正式脚本必须入库（覆盖上面 scripts/validation-*.mts 的宽泛忽略）
!scripts/generate-table-fixtures.mts
!scripts/validation-table-baseline.mts
