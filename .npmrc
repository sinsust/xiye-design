# Vercel/本地 npm install 统一容忍 peer 依赖冲突
# gantt-task-react@0.3.9 peer 要求 react ^18，项目用 react 19.2.8（本地已验证可用）
legacy-peer-deps=true

# npm 11+ allow-scripts 安全功能：默认阻止依赖的 install 脚本，
# Vercel 构建时若未放行会警告并导致 esbuild/sharp 等二进制不完整。
# 白名单（这些包的安装脚本是必要的构建步骤，非恶意）：
allow-scripts=esbuild,sharp,better-sqlite3,protobufjs,unrs-resolver

# pnpm 用扁平布局（无 .pnpm symlink）：Next + Vercel 产物上传要求函数内
# node_modules 为真实文件；符号链接布局会在 "Deploying outputs" 阶段被拒。
node-linker=hoisted
