{
  "name": "xiye",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3200",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "validate": "npm run validate:table-baseline && npm run validate:table-session-l2 && npm run validate:combine",
    "db:push:pg": "drizzle-kit push --config drizzle.config.pg.ts",
    "generate:table-fixtures": "esbuild scripts/generate-table-fixtures.mts --bundle --platform=node --format=esm --packages=external --outfile=scripts/.tmp-gentf.mjs && node scripts/.tmp-gentf.mjs",
    "validate:table-baseline": "esbuild scripts/validation-table-baseline.mts --bundle --platform=node --format=esm --resolve-extensions=.mts,.ts,.tsx,.js,.jsx,.json --external:xlsx --external:chardet --external:iconv-lite --external:zod --outfile=scripts/.tmp-valtf.mjs && node scripts/.tmp-valtf.mjs",
    "validate:table-session-l2": "esbuild scripts/validation-table-session-l2.mts --bundle --platform=node --format=esm --packages=external --alias:@=. --alias:next/headers=./scripts/_stub-next-headers.mts --resolve-extensions=.mts,.ts,.tsx,.js,.jsx,.json --outfile=scripts/.tmp-vl2.mjs && node scripts/.tmp-vl2.mjs",
    "validate:combine": "esbuild scripts/validation-combine.mts --bundle --platform=node --format=esm --resolve-extensions=.mts,.ts,.tsx,.js,.jsx,.json --outfile=scripts/.tmp-combine.mjs && node scripts/.tmp-combine.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@gsap/react": "^2.1.2",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.3",
    "@tanstack/react-table": "^8.21.3",
    "@xenova/transformers": "^2.17.2",
    "better-sqlite3": "^13.0.3",
    "chardet": "^2.1.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.2",
    "echarts": "^6.1.0",
    "exceljs": "^4.4.0",
    "framer-motion": "^13.1.1",
    "gantt-task-react": "^0.3.9",
    "gsap": "^3.15.0",
    "iconv-lite": "0.7.3",
    "lucide-react": "^1.32.0",
    "motion": "^13.1.1",
    "next": "16.2.11",
    "papaparse": "^5.4.1",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.6.0",
    "three": "^0.185.1",
    "tw-animate-css": "^1.4.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.4.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^20",
    "@types/papaparse": "^5.3.14",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "playwright": "^1.62.1",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "shadcn": "^4.18.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "overrides": {
    "uuid": "^9.0.1"
  }
}
