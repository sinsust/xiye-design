# Public site URL. Drives canonical tags, Open Graph URLs, sitemap and robots.
# Mirrors `url` in config/site.ts — set both when you deploy.
NEXT_PUBLIC_SITE_URL=https://example.com

# Endpoint the contact form posts to. The original export used a private Framer
# endpoint, which was removed. Point this at your own handler or a service.
NEXT_PUBLIC_CONTACT_ENDPOINT=
