# ═══ 数据库（Supabase Postgres）════
# 设置以下任一变量后，应用自动切换为 Supabase Postgres（Vercel 线上部署用）；
# 不设置则回退本地 SQLite 文件库（本地开发用）。识别优先级：
#   DATABASE_URL → POSTGRES_URL → SUPABASE_DB_URL → POSTGRES_URL_NON_POOLING
# （Vercel 的 Supabase 集成通常会自动注入上述其一，无需手填。）
# 在 Supabase 控制台「Project Settings → Database」复制 Connection string（Pooled），
# 形如：postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres?pgbouncer=true
DATABASE_URL=

# 本地回退用的 SQLite 文件路径（仅当未设置任何 Postgres 连接串时生效）
# SQLITE_PATH=./xiye.db

# ⚠️ 部署前必做（否则线上库无表，应用一碰数据库就报错）：
# 本地 SQLite 会在启动时自动建表，但 Supabase/Postgres 路径【不会】自动建表。
# 首次部署到 Vercel 前（或之后补跑也行），需把 schema.pg.ts 物化进 Supabase 一次：
#   导出你的 Supabase 连接串后执行：
#     export DATABASE_URL="postgresql://postgres:<密码>@db.<ref>.supabase.co:5432/postgres"
#     npm run db:push:pg
# 之后凡改过 lib/db/schema.pg.ts 的字段，都要再跑一次该命令保持对齐。

# ═══ 会话签名（必填，生产用强随机值）═══
# 用于 jose 对 session JWT 签名。生成方式：openssl rand -base64 32
AUTH_SECRET=

# ═══ 真实 AI 意图解构（可选）════
# 配置后，流程第一步「一句话生成」会用 DeepSeek 真实解构用户想法；
# 未配置则自动回退到内置的本地启发式推导，功能仍可用。

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ═══ 大模型备用配置（预留，多供方接入用）═══
# 当前 AI 对话理解固定走 DeepSeek；LLM_MODEL_* 预留给其它场景，由调用方按需接入。

LLM_MODEL_BASE_URL=
LLM_MODEL_API_KEY=
LLM_MODEL_MODEL_ID=
