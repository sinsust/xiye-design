# ═══ 数据库（Supabase Postgres）════
# 设置以下任一变量后，应用自动切换为 Supabase Postgres（Vercel 线上部署用）；
# 不设置则回退本地 SQLite 文件库（本地开发用）。识别优先级：
#   DATABASE_URL → POSTGRES_URL → SUPABASE_DB_URL → POSTGRES_URL_NON_POOLING
# （Vercel 的 Supabase 集成通常会自动注入上述其一，无需手填。）
# 在 Supabase 控制台「Project Settings → Database」复制 Connection string（Pooled），
# 形如：postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres?pgbouncer=true
DATABASE_URL=

# ═══ Supabase 认证（登录/注册/会话）═══
# Project URL 与 anon key 是公开的，可注入 NEXT_PUBLIC_* 供浏览器端使用；
# service_role 是服务端密钥，绝不能暴露到浏览器，只能用于后端/迁移脚本。
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ⚠️ SUPABASE_SERVICE_ROLE_KEY 在【线上部署必填】，不是可选项：
# 表格分析会话持久化（lib/table/session-persist.ts）用 service_role 绕过 RLS 写
# brain_table_sessions。Serverless 多实例/冷启动下，进程内 Map 会丢，必须靠这张表兜底；
# 缺这个变量 → L2 直接停用并打印一次告警 → 表格分析在跨实例时报 410 table_expired。
SUPABASE_SERVICE_ROLE_KEY=

# ═══ ima 凭证加密密钥（必填，生产必须配置；本地与生产务必用同一把）═══
# 用于 AES-256 加密用户绑定的腾讯 ima 凭证。≥32 字符。
# 生成：node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
IMA_ENC_KEY=

# 本地回退用的 SQLite 文件路径（仅当未设置任何 Postgres 连接串时生效）
# SQLITE_PATH=./xiye.db

# ⚠️ 部署前必做（否则线上库无表，应用一碰数据库就报错）：
# 本地 SQLite 会在启动时自动建表，但 Supabase/Postgres 路径【不会】自动建表。
# 首次部署到 Vercel 前（或之后补跑也行），需把 schema.pg.ts 物化进 Supabase 一次：
#   导出你的 Supabase 连接串后执行：
#     export DATABASE_URL="postgresql://postgres:<密码>@db.<ref>.supabase.co:5432/postgres"
#     npm run db:push:pg
# 之后凡改过 lib/db/schema.pg.ts 的字段，都要再跑一次该命令保持对齐。

# ═══ 会话签名（必填，生产用强随机值）═══
# 用于 jose 对 session JWT 签名。生成方式：openssl rand -base64 32
AUTH_SECRET=

# ═══ 真实 AI 意图解构（可选）════
# 配置后，流程第一步「一句话生成」会用 DeepSeek 真实解构用户想法；
# 未配置则自动回退到内置的本地启发式推导，功能仍可用。

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ═══ 大模型备用配置（预留，多供方接入用）═══
# 当前 AI 对话理解固定走 DeepSeek；LLM_MODEL_* 预留给其它场景，由调用方按需接入。

LLM_MODEL_BASE_URL=
LLM_MODEL_API_KEY=
LLM_MODEL_MODEL_ID=

# ═══ 飞书导入（可选功能；配置后「从飞书导入表格」才可用）═══
# 飞书开放平台建自建应用后获取 App ID / App Secret。
# 缺任一变量时，飞书相关接口会抛明确错误（见 lib/feishu/client.ts:39），不影响其它功能。
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# ⚠️ 下面两个是【带域名的地址】，线上部署必须换成线上域名，不能沿用 localhost，
#    否则飞书 OAuth 回调会跳回本机导致授权失败。
#    同一地址还需在飞书开放平台「安全设置 → 重定向 URL」里登记，否则飞书侧拒绝回调。
#    本地示例：http://localhost:3200/api/feishu/callback
#    线上示例：https://<你的域名>/api/feishu/callback
FEISHU_REDIRECT_URI=
# 授权完成后跳回的前端首页（本地 http://localhost:3200/ ；线上 https://<你的域名>/ ）
FEISHU_FRONTEND_HOME=

# ═══ OriginKit（可选）═══
ORIGINKIT_API_KEY=
