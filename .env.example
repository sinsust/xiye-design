# ═══ 数据存放位置（先决定这个，再谈数据库）═══
# 不设置（默认）→ 本地/桌面形态：数据在你这台机器的 xiye.db（或 PG），/api 由 Next 服务端处理。
# 设为 1        → 浏览器数据层：/api 全部由浏览器内的 Service Worker 处理，
#                 数据存在访问人自己的浏览器里（IndexedDB 中一个 SQLite 文件），
#                 服务端不存任何业务数据，因此线上【不需要数据库】。
#                 同时要跑一次 npm run build（或 node scripts/build-sw.mjs）生成 public/sw.js。
# 代价（必须知道）：清浏览器数据 / 换设备 / 无痕模式 = 数据没了；同一浏览器的多个档案共用一份库。
NEXT_PUBLIC_BROWSER_DB=

# ═══ 部署形态（与数据存放位置正交，见下方「公开部署模式」）═══
# 浏览器数据层本身已经是「各人存各人浏览器」，通常不需要再开 DEPLOY_MODE=public。

# ═══ 数据库 ═══
# 仅本地/桌面与服务端 public 形态需要；浏览器数据层用不到（它不连任何数据库）。
# 模式由单一开关决定（推荐）：
#   DB_MODE=sqlite  → 本地 SQLite 单机库（默认形态，桌面/单机使用）
#   DB_MODE=pg      → 强制 Postgres（缺连接串时启动即报错，杜绝静默回退）
#   DB_MODE=browser → 浏览器 SQLite（sql.js + IndexedDB）；由 sw 打包脚本注入，不用手填
# 未设置 DB_MODE 时按连接串自动探测：有连接串 → pg，否则 sqlite。
# 连接串识别优先级：DATABASE_URL → POSTGRES_URL → SUPABASE_DB_URL → POSTGRES_URL_NON_POOLING
DB_MODE=sqlite
DATABASE_URL=

# ═══ ima 凭证与 API Key 的加密密钥 ═══
# 本地/服务端形态必填（≥32 字符）：AES-256-GCM 加密 ima 凭证与模型 API Key。
#   生成：node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
# 浏览器数据层【不使用】这把密钥：加密钥只可能来自部署方的 env，而线上不落服务端，
#   库就是访问人自己机器上的一个文件 —— 同机可取的加密等于零，所以那边明确存明文
#   （前缀 plain: 标记，见 lib/ima-config.ts）。
IMA_ENC_KEY=

# 本地回退用的 SQLite 文件路径（仅当未设置任何 Postgres 连接串时生效）
# SQLITE_PATH=./xiye.db

# ⚠️ 以下这段只适用于「服务端数据库」形态（DB_MODE=pg，或 DEPLOY_MODE=public 那种多用户服务端）。
# 浏览器数据层（NEXT_PUBLIC_BROWSER_DB=1）用不到：它的库在访问人浏览器里，
# 首次打开时由 sw 现场跑同一份建表 DDL（lib/db/ddl-sqlite.ts），线上不碰任何数据库。
#
# 本地 SQLite 会在启动时自动建表，但 Supabase/Postgres 路径【不会】自动建表。
# 首次部署到 Vercel 前（或之后补跑也行），需把 schema.pg.ts 物化进 Supabase 一次：
#   导出你的 Supabase 连接串后执行：
#     export DATABASE_URL="postgresql://postgres:<密码>@db.<ref>.supabase.co:6543/postgres"
#     npm run db:push:pg
# 之后凡改过 lib/db/schema.pg.ts 的字段，都要再跑一次该命令保持对齐。

# ═══ 公开部署模式（Vercel 多用户；本地单机不用管）═══
# DEPLOY_MODE=public 时启用「邀请码门户 + 服务端 HMAC 签名 cookie 身份」：
#   未认证访客一律拦在 /enter；手写 cookie 冒充他人档案会被验签拒绝。
# 不设置（或 =local）时行为与现在完全一致：免登录、档案由前端 cookie 自由切换。
# ⚠️ 客户端组件也要读这个开关，故线上需【两个都设】（或只设 NEXT_PUBLIC_ 那个）。
# DEPLOY_MODE=public
# NEXT_PUBLIC_DEPLOY_MODE=public

# 签名密钥：给档案 cookie 做 HMAC-SHA256 签名。≥32 字符，缺失时验签直接抛错（不静默放行）。
# 生成：node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# PROFILE_HMAC_KEY=

# 邀请码白名单：逗号分隔，可多个。不配置 = 门户拒绝任何人进入（access_disabled）。
# ACCESS_CODE=xiye-2026,friend-a

# 线上无需监听本机文件系统（Obsidian watcher 每次冷启动白跑）：设 0 关掉。
# OBSIDIAN_AUTOSTART=0

# ═══ 飞书导入（可选功能；配置后「从飞书导入表格」才可用）═══
# 飞书开放平台建自建应用后获取 App ID / App Secret。
# 缺任一变量时，飞书相关接口会抛明确错误（见 lib/feishu/client.ts:39），不影响其它功能。
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# ⚠️ 下面两个是【带域名的地址】，线上部署必须换成线上域名，不能沿用 localhost，
#    否则飞书 OAuth 回调会跳回本机导致授权失败。
#    同一地址还需在飞书开放平台「安全设置 → 重定向 URL」里登记，否则飞书侧拒绝回调。
#    本地示例：http://localhost:3200/api/feishu/callback
#    线上示例：https://<你的域名>/api/feishu/callback
FEISHU_REDIRECT_URI=
# 授权完成后跳回的前端首页（本地 http://localhost:3200/ ；线上 https://<你的域名>/ ）
FEISHU_FRONTEND_HOME=

# ═══ OriginKit（可选）═══
ORIGINKIT_API_KEY=
