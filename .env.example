# ═══ 数据库（Supabase Postgres）════
# 设置 DATABASE_URL 后，应用自动切换为 Supabase Postgres（Vercel 线上部署用）；
# 不设置则回退本地 SQLite 文件库（本地开发用）。
# 在 Supabase 控制台「Project Settings → Database」复制 Connection string（Pooled），
# 形如：postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres?pgbouncer=true
DATABASE_URL=

# 本地回退用的 SQLite 文件路径（仅当未设置 DATABASE_URL 时生效）
# SQLITE_PATH=./xiye.db

# ═══ 会话签名（必填，生产用强随机值）═══
# 用于 jose 对 session JWT 签名。生成方式：openssl rand -base64 32
AUTH_SECRET=

# ═══ 真实 AI 意图解构（可选）════
# 配置后，流程第一步「一句话生成」会用 DeepSeek 真实解构用户想法；
# 未配置则自动回退到内置的本地启发式推导，功能仍可用。

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ═══ 大模型备用配置（预留，多供方接入用）═══
# 当前 AI 对话理解固定走 DeepSeek；LLM_MODEL_* 预留给其它场景，由调用方按需接入。

LLM_MODEL_BASE_URL=
LLM_MODEL_API_KEY=
LLM_MODEL_MODEL_ID=
